<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="150.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.financestep.controller.NuovaTransazioneController">
   <children>
      <Label layoutX="28.0" layoutY="14.0" text="Nuova Transazione">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="txtDescrizione" layoutX="28.0" layoutY="50.0" promptText="Descrizione" />
      <TextField fx:id="txtImporto" layoutX="211.0" layoutY="50.0" promptText="Importo" />
      <TextField fx:id="txtTipo" layoutX="405.0" layoutY="50.0" promptText="Tipo" />
      <TextField fx:id="txtData" layoutX="28.0" layoutY="94.0" promptText="Data" />
      <Button fx:id="salvaTransazione" defaultButton="true" layoutX="211.0" layoutY="94.0" mnemonicParsing="false" onAction="#salvaTransazione" text="Salva" />
      <Button fx:id="chiudiFinestra" cancelButton="true" layoutX="286.0" layoutY="94.0" mnemonicParsing="false" onAction="#chiudiFinestra" text="Annulla" />
   </children>
</AnchorPane>
