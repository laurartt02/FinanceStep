<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.StackPane?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.financestep.controller.RegistrazioneController">

    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="Crea il tuo account">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <VBox spacing="5.0">
        <Label text="Nome Utente:" />
        <TextField fx:id="txtUsername" promptText="Scegli uno username..." />
    </VBox>

    <VBox spacing="5.0">
        <Label text="Password:" />
        <StackPane>
            <PasswordField fx:id="txtPassword" promptText="Scegli una password..." />
            <TextField fx:id="txtPasswordVisibile" promptText="Scegli una password..." visible="false" managed="false" />
            <Button fx:id="btnTogglePassword" text="👁"
                    onAction="#toggleMostraPassword"
                    StackPane.alignment="CENTER_RIGHT"
                    style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0 10 0 0;" />
        </StackPane>
    </VBox>

    <VBox spacing="5.0">
        <Label text="Ruolo:" />
        <ComboBox fx:id="comboRuolo" maxWidth="Infinity" />
    </VBox>

    <Button text="Conferma registrazione" onAction="#handleConfermaRegistrazione" maxWidth="Infinity" style="-fx-font-weight: bold;" />

</VBox>
