<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="rootVBox" alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.financestep.controller.MainController">
    <children>
        <BorderPane VBox.vgrow="ALWAYS">
            <top>
                <MenuBar BorderPane.alignment="CENTER">
                    <menus>
                        <Menu mnemonicParsing="false" text="File">
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#gestisciSave" text="Save" />
                                <MenuItem fx:id="menuReset" mnemonicParsing="false" onAction="#gestisciReset" text="Reset" />
                                <SeparatorMenuItem />
                                <MenuItem mnemonicParsing="false" onAction="#gestisciLogout" text="Logout" />
                                <MenuItem mnemonicParsing="false" onAction="#gestisciClose" text="Close" />
                            </items>
                        </Menu>
                        <Menu mnemonicParsing="false" text="Edit">
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#gestisciEditTransazione" text="Modifica Selezionata..." />
                                <MenuItem mnemonicParsing="false" onAction="#gestisciFiltra" text="Filtra Transazioni..." />
                                <MenuItem fx:id="menuEditDeseleziona" mnemonicParsing="false" onAction="#gestisciDeseleziona" text="Annulla Selezione" />
                                <SeparatorMenuItem />
                                <MenuItem fx:id="menuEditDelete" mnemonicParsing="false" onAction="#gestisciDelete" text="Elimina Selezionata" />
                            </items>
                        </Menu>
                        <Menu mnemonicParsing="false" text="Help">
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#gestisciGuida" text="Guida all'Uso" />
                                <SeparatorMenuItem />
                                <MenuItem mnemonicParsing="false" onAction="#gestisciInfo" text="Informazioni su FinanceStep" />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>
            </top>
            <center>
                <VBox spacing="15.0" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0" VBox.vgrow="NEVER">
                            <children>
                                <Label fx:id="lblPersonaCorrente" text="Persona: -">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>

                        <!-- 1. SEZIONE PORTAFOGLIO E SALVADANAIO (SI ALLARGANO IN LARGHEZZA) -->
                        <HBox spacing="15.0" VBox.vgrow="NEVER">
                            <children>
                                <TitledPane animated="false" collapsible="false" text="Saldo Portafoglio" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                    <content>
                                        <VBox spacing="10.0">
                                            <children>
                                                <Label fx:id="lblSaldoPortafoglio" text="150.00">
                                                    <font>
                                                        <Font size="16.0" />
                                                    </font>
                                                </Label>
                                                <Button mnemonicParsing="false" onAction="#apriNuovaTransizione" text="Nuova Transazione" />
                                            </children>
                                            <padding>
                                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                            </padding>
                                        </VBox>
                                    </content>
                                </TitledPane>

                                <TitledPane animated="false" collapsible="false" text="Salvadanaio" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                    <content>
                                        <VBox spacing="10.0">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label fx:id="lblSalvadanaio" text="300.00">
                                                            <font>
                                                                <Font size="16.0" />
                                                            </font>
                                                        </Label>
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Label text="Obiettivo:">
                                                            <font>
                                                                <Font size="13.0" />
                                                            </font>
                                                        </Label>
                                                        <Label fx:id="lblObiettivo" text="600.00">
                                                            <font>
                                                                <Font size="14.0" />
                                                            </font>
                                                        </Label>
                                                        <Button fx:id="btnModificaObiettivo" mnemonicParsing="false" onAction="#modificaObiettivo" text="Modifica">
                                                            <font>
                                                                <Font size="11.0" />
                                                            </font>
                                                        </Button>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="10.0">
                                                    <children>
                                                        <Button mnemonicParsing="false" onAction="#versaNelSalvadanaio" text="+ Versa" />
                                                        <Button mnemonicParsing="false" onAction="#prelevaDalSalvadanaio" text="- Preleva" />
                                                    </children>
                                                </HBox>
                                            </children>
                                            <padding>
                                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                            </padding>
                                        </VBox>
                                    </content>
                                </TitledPane>
                            </children>
                        </HBox>

                        <!-- 2. I TRE BOTTONI CENTRATI PER LE SCHEDE -->
                        <HBox alignment="CENTER" prefHeight="35.0" spacing="10.0" VBox.vgrow="NEVER">
                            <children>
                                <Button mnemonicParsing="false" onAction="#mostraTransazioni" text="Transazioni" />

                                <StackPane>
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#mostraCompiti" text="Compiti" />
                                        <Label fx:id="badgeCompiti"
                                               text="0"
                                               visible="false"
                                               style="-fx-background-color: #e53935; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 1 6 1 6; -fx-font-size: 11px; -fx-font-weight: bold;"
                                               StackPane.alignment="TOP_RIGHT"
                                               translateX="8" translateY="-8" />
                                    </children>
                                </StackPane>

                                <StackPane>
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#mostraRichieste" text="Richieste Extra" />
                                        <Label fx:id="badgeRichieste"
                                               text="0"
                                               visible="false"
                                               style="-fx-background-color: #e53935; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 1 6 1 6; -fx-font-size: 11px; -fx-font-weight: bold;"
                                               StackPane.alignment="TOP_RIGHT"
                                               translateX="8" translateY="-8" />
                                    </children>
                                </StackPane>
                            </children>
                        </HBox>

                        <!-- 3. STACKPANE TABELLE (OCCUPA TUTTO LO SPAZIO RIMANENTE IN ALTEZZA E LARGHEZZA) -->
                        <StackPane VBox.vgrow="ALWAYS">
                            <children>
                                <TableView fx:id="tableTransazioni">
                                    <columns>
                                        <TableColumn fx:id="colData" prefWidth="75.0" text="Data" />
                                        <TableColumn fx:id="colDescrizione" prefWidth="75.0" text="Descrizione" />
                                        <TableColumn fx:id="colTipo" prefWidth="75.0" text="Tipo" />
                                        <TableColumn fx:id="colImporto" prefWidth="75.0" text="Importo" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                                <TableView fx:id="tableCompiti" visible="false">
                                    <columns>
                                        <TableColumn fx:id="colCompitoTitolo" prefWidth="75.0" text="Titolo" />
                                        <TableColumn fx:id="colCompitoPremio" prefWidth="75.0" text="Premio" />
                                        <TableColumn fx:id="colCompitoScadenza" prefWidth="75.0" text="Scadenza" />
                                        <TableColumn fx:id="colCompitoDestinatario" prefWidth="75.0" text="Destinatario" />
                                        <TableColumn fx:id="colCompitoMittente" prefWidth="75.0" text="Mittente" />
                                        <TableColumn fx:id="colCompitoStato" prefWidth="75.0" text="Stato" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                                <TableView fx:id="tableRichieste" visible="false">
                                    <columns>
                                        <TableColumn fx:id="colRichiestaData" prefWidth="75.0" text="Data" />
                                        <TableColumn fx:id="colRichiestaImporto" prefWidth="75.0" text="Importo" />
                                        <TableColumn fx:id="colRichiestaMotivazione" prefWidth="75.0" text="Motivazione" />
                                        <TableColumn fx:id="colRichiestaRichiedente" prefWidth="75.0" text="Richiedente" />
                                        <TableColumn fx:id="colRichiestaConcedente" prefWidth="75.0" text="Concedente" />
                                        <TableColumn fx:id="colRichiestaStato" prefWidth="75.0" text="Stato" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </StackPane>

                        <!-- 4. SOTTO LA TABELLA: BOTTONI AZIONE CENTRATI -->
                        <StackPane alignment="CENTER" VBox.vgrow="NEVER">
                            <children>
                                <Button fx:id="btnNuovoCompito" mnemonicParsing="false" onAction="#apriNuovoTask" text="+ Nuovo Compito" visible="false" />
                                <Button fx:id="btnNuovaRichiesta" mnemonicParsing="false" onAction="#apriNuovaRichiesta" text="+ Nuova Richiesta" visible="false" />
                                <Button fx:id="btnMonitoraJunior" mnemonicParsing="false" onAction="#apriMonitoraJunior" text="Monitora Transazioni di uno Junior" visible="false" />
                            </children>
                        </StackPane>
                    </children>
                </VBox>
            </center>
        </BorderPane>
    </children>
</VBox>