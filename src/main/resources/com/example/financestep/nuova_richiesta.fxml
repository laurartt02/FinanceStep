<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.financestep.controller.NuovaRichiestaController" prefWidth="320.0">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label text="Nuova Richiesta Extra" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <Label text="Importo richiesto (€):"/>
    <TextField fx:id="txtImporto" promptText="Es. 15.00"/>

    <Label text="Motivazione:"/>
    <TextArea fx:id="txtMotivazione" promptText="Es. Biglietto del cinema" prefRowCount="3" wrapText="true"/>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button text="Annulla" onAction="#gestisciAnnulla"/>
        <Button text="Invia Richiesta" onAction="#gestisciSalva" style="-fx-background-color: #1565c0; -fx-text-fill: white;"/>
    </HBox>
</VBox>
