<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.financestep.LoginController">

    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="FinanceStep Login">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <VBox spacing="5.0">
        <Label text="Nome Utente:" />
        <TextField fx:id="txtNome" promptText="Inserisci il tuo nome..." />
    </VBox>

    <VBox spacing="5.0">
        <Label text="Ruolo:" />
        <ComboBox fx:id="comboRuolo" maxWidth="Infinity" />
    </VBox>

    <Button text="Accedi" onAction="#gestisciLogin" maxWidth="Infinity" style="-fx-font-weight: bold;" />

</VBox>
